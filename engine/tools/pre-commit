#!/bin/sh
# Проверка перед каждым коммитом. Ставится локально, в репозиторий не едет.
# Пропустить в исключительном случае:  git commit --no-verify

python3 engine/tools/build.py
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "──────────────────────────────────────────────"
  echo " Коммит остановлен: сборка нашла проблему."
  echo " Выше написано, в каком файле и какую."
  echo "──────────────────────────────────────────────"
  exit 1
fi

# Собранные CSS и JS должны совпадать с исходниками в этом же коммите
git add public/assets/css/main.css public/assets/js/main.js 2>/dev/null
exit 0
