# ─────────────────────────────────────────────────────────────────────
#  nginx для сайта на ritmo-engine
#
#  Движок без этого файла неполон. Четыре вещи, которые PHP сделать
#  не может в принципе, потому что для них он не запускается:
#
#    1. маршрут 404 на свою страницу
#    2. один канонический адрес (хост и слэш) через 301
#    3. редиректы со старых адресов перед запуском
#    4. заголовки кэша на статику
#
#  Про четвёртый пункт отдельно, потому что это неочевидно и стоило
#  нам разбора: /assets/* отдаёт сам nginx — нашёл файл на диске,
#  отправил, интерпретатор не просыпался. Значит header() из PHP до
#  этих запросов не доходит, и .htaccess тоже не поможет: это файл
#  Apache, nginx его не читает вовсе. Единственное место для кэша —
#  вот этот конфиг.
#
#  Куда класть: в конфиг сайта (в панели — поле директив для домена),
#  не в общий nginx.conf. Правила касаются одного домена.
#
#  ВАЖНО про root: докрут указывает на public/ внутри репозитория, а не
#  на сам репозиторий. Наружу отдаётся только то, что лежит в public —
#  страницы и assets. Исходники блоков, engine/, content/, fonts-src/,
#  .md-файлы и .git остаются на уровень выше и недостижимы через веб.
#  Это надёжнее, чем запрещать их правилами: забытое правило открывает
#  файл молча, а отсутствующий в докруте файл не отдать нельзя.
#
#  Перед правкой — посмотреть, что в конфиге уже есть. Панели часто
#  сами кладут location для статики. Из регулярных location nginx
#  выбирает ПЕРВЫЙ подошедший, а не самый подходящий, поэтому наш
#  блок, поставленный ниже чужого, молча не сработает. Если такой
#  блок уже есть — не добавлять наш рядом, а заменить им чужой.
#
#  После правки:  nginx -t && systemctl reload nginx
#  Проверка:      curl -sI https://САЙТ/assets/css/main.css | grep -i cache
# ─────────────────────────────────────────────────────────────────────


# ── 0. Блок по умолчанию ────────────────────────────────────────────
# Запрос с чужим или пустым заголовком Host попадает в ПЕРВЫЙ server
# этого файла — не в тот, чьё имя совпало, а просто в первый. Без
# такого блока это оказывается боевой сайт, и он отвечает на любое
# имя, которое кто-то навёл на наш IP.
#
# Это же страхует проверку хоста в head.php: она смотрит SERVER_NAME,
# то есть server_name из конфига, и запрос, не совпавший ни с одним
# именем, до PHP доходить не должен вовсе.
#
# 444 — закрыть соединение молча, без ответа. Ошибку здесь показывать
# некому: по чужому имени на наш сайт приходит не человек.

# СНАЧАЛА ПРОВЕРИТЬ, НЕТ ЛИ УЖЕ. У панелей такой блок обычно свой:
# в FastPanel это /etc/nginx/conf.d/parking.conf — заглушка «сайт не
# найден» на все адреса сразу, включая IPv6. Она задачу решает, второй
# блок рядом только не даст nginx запуститься:
#
#     nginx: [emerg] a duplicate default server for <ip>:80
#
# Поэтому сначала:
#
#     grep -rl default_server /etc/nginx/
#
# Нашлось — ничего не добавлять, проверить, что покрыты и :80, и :443,
# и адреса те же, что у сайтов.

# ВАЖНО про адрес. default_server действует не «вообще», а на свою
# пару адрес:порт. Панели часто пишут сайтам listen <публичный-ip>:80
# вместо listen 80 — и тогда блок ниже, написанный без адреса, во-первых
# не станет умолчанием для их сокета, а во-вторых не даст nginx
# перезапуститься: 0.0.0.0:80 рядом с занятым <ip>:80 ядро не отдаёт
# (nginx -t при этом проходит, падает именно перезагрузка). Посмотреть,
# как слушают остальные, и написать так же:
#
#     ss -lntp | grep -E ':(80|443)\s'

server {
	listen 80 default_server;
	listen 443 ssl default_server;
	server_name _;
	ssl_reject_handshake on;      # nginx 1.19.4+; на старых — любой сертификат
	return 444;
}

# Версию nginx в заголовках и на страницах ошибок печатать незачем:
# это подсказка, какие уязвимости пробовать.
server_tokens off;


# ── 1. Канонический адрес ───────────────────────────────────────────
# Один и тот же документ, доступный по четырём адресам (www и без,
# http и https), — это четыре конкурента в индексе. Схлопываем в один
# 301-м, а не rel=canonical: canonical это просьба, 301 это ответ.

server {
	listen 80;
	server_name САЙТ.ru www.САЙТ.ru;
	return 301 https://САЙТ.ru$request_uri;
}

server {
	listen 443 ssl http2;
	server_name www.САЙТ.ru;
	# сертификаты — те же, что у основного блока. Сертификат должен
	# включать www: certbot -d САЙТ.ru -d www.САЙТ.ru. Иначе www отдаёт
	# чужой или самоподписанный сертификат, и редирект сюда не доходит.
	return 301 https://САЙТ.ru$request_uri;
}


# ── Основной блок ───────────────────────────────────────────────────

server {
	listen 443 ssl http2;
	server_name САЙТ.ru;
	# Именно /public. И два предупреждения про панели хостинга.
	#
	# Первое: ISPmanager и FastPanel генерируют этот конфиг из своих
	# полей. Правка руками живёт до первого сохранения сайта в панели —
	# потом докрут вернётся к папке сайта, и наружу снова поедут
	# исходники и .git. Поэтому задавать надо ПОЛЕ «Корневая
	# директория» (с /public на конце), а файл править только когда
	# панель недоступна — и не забыть вписать поле, когда оживёт.
	#
	# Второе: если перед PHP стоит Apache (в ISPmanager это schema с
	# proxy_pass на 127.0.0.1:80xx), у него свой DocumentRoot, и менять
	# надо оба — иначе статику nginx отдаст из public, а страницы
	# Apache по-прежнему из старого корня. Там же проверить
	# open_basedir: страницы подключают engine/ и content/ ВЫШЕ
	# докрута, поэтому ограничение должно стоять на папке сайта, а не
	# на public.
	root /var/www/САЙТ/data/www/САЙТ.ru/public;
	index index.php;

	# ── Заголовки безопасности ─────────────────────────────────────
	# HSTS: блок 1 уводит с http на https 301-м, но первый запрос
	# посетителя всё равно успевает уйти в открытую — и его можно
	# перехватить до редиректа. HSTS говорит браузеру ходить на этот
	# хост только по https, не спрашивая. Срок год, иначе смысла нет.
	#
	# ВАЖНО, иначе половина строк ниже не сработает: add_header в
	# location ОТМЕНЯЕТ все add_header уровня выше, а не дополняет их.
	# Поэтому в блоках кэша эти заголовки повторены — не копипастой,
	# а по необходимости. Если панель даёт подключать файлы, лучше
	# вынести их в snippets/security.conf и делать include в каждом
	# location; одним файлом-примером это не выразить.
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;

	# CSP. У движка внешний скрипт ровно один — Метрика, поэтому
	# список можно держать закрытым, а не отписываться звёздочкой.
	# 'unsafe-inline' в script-src нужен из-за инлайнового тега
	# счётчика в footer.php: вынесут его в файл — строку убрать.
	# frame-ancestors запрещает показывать сайт в чужом фрейме,
	# base-uri — подменять базовый адрес относительных ссылок.
	#
	# Проверять после включения: открыть сайт, посмотреть консоль и
	# цели в Метрике. Счётчик однажды подтянет что-нибудь ещё со
	# своих адресов (Вебвизор это умеет) — в консоли будет видно,
	# какой хост заблокирован, его и дописать. Молча ломается только
	# статистика, страница остаётся рабочей.
	add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; font-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

	# ── 2. Страница «не найдено» ───────────────────────────────────
	# 404.php сам ставит http_response_code(404) и $noindex, поэтому
	# здесь только маршрут. Без этой строки посетитель видит белую
	# страницу nginx, а поиск — чужую вёрстку на твоём домене.
	error_page 404 /404.php;

	# ── Файлы с точкой ─────────────────────────────────────────────
	# Второй слой под докрут, и нужен он ровно для случая, когда
	# первый слой отказал. Наружу не отдаётся ничего лишнего, пока
	# докрут указывает на public/ — но докрут собирает панель из
	# своего поля, а файлы на этот сервер однажды заливали по FTP
	# вместе с папкой .git (см. записку в конце файла). Два контроля
	# с одним отказом — это один контроль.
	#
	# Этот location стоит ПЕРВЫМ среди регулярных не случайно: nginx
	# берёт первый подошедший, а не самый подходящий, и ниже стоит
	# location для .css — он бы подхватил /.git/что-нибудь.css.
	#
	# Исключение для .well-known обязательно: без него перестаёт
	# работать ACME-челлендж, то есть через три месяца не продлится
	# сертификат. Это тот же путь, что в записке о челлендже ниже.
	location ~ /\.(?!well-known) {
		deny all;
		access_log off;
		log_not_found off;
	}

	# ── 3. Редиректы со старых адресов ─────────────────────────────
	# Нужны при переносе существующего сайта: без них накопленные
	# ссылки и позиции уходят в 404. Карта — отдельным файлом, чтобы
	# не раздувать конфиг: «старый_путь новый_путь;» построчно.
	# include /etc/nginx/redirects.map;   # include map в http-секции
	# if ($redirect_to) { return 301 $redirect_to; }

	# ── Слэш на конце ──────────────────────────────────────────────
	# Страница живёт как папка с index.php (/about/), значит адрес со
	# слэшом — канонический. Без слэша nginx и сам сделает редирект,
	# но через свой server_name и порт; строка ниже страхует от того,
	# что за прокси он уедет на http или на внутренний адрес.
	# absolute_redirect off;  port_in_redirect off;

	# ── 4. Кэш статики ─────────────────────────────────────────────
	# immutable значит «не перепроверяй, пока срок не вышел». Это
	# можно говорить только про файл, адрес которого меняется вместе
	# с содержимым.
	#
	# css и js — можно: head.php вешает ?v=<mtime>, собрал заново —
	# адрес другой, браузер скачает новый файл.
	location ~* \.(css|js)$ {
		expires 1y;
		add_header Cache-Control "public, immutable";
		# Повтор из блока выше: свой add_header отменяет наследование.
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header X-Content-Type-Options "nosniff" always;
		access_log off;
	}

	# Шрифты — можно: файл стабилен, меняется раз в жизни проекта.
	# (Если шрифты всё-таки заменят — переименовать файлы, иначе
	# вернувшийся посетитель год не увидит замены.)
	# Только woff2: ttf это исходник, он лежит в fonts-src/ вне докрута.
	location ~* \.woff2$ {
		expires 1y;
		add_header Cache-Control "public, immutable";
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header X-Content-Type-Options "nosniff" always;
		access_log off;
	}

	# Картинки и видео — нельзя immutable и нельзя год: их меняют под
	# тем же именем. Заменённый логотип должен доезжать до людей за
	# понятный срок, поэтому неделя и обычный public.
	location ~* \.(svg|png|jpg|jpeg|webp|avif|mp4|ico)$ {
		expires 7d;
		add_header Cache-Control "public";
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		# Для картинок nosniff важнее всего: он не даёт браузеру
		# решить, что присланный под видом .svg файл — это HTML.
		add_header X-Content-Type-Options "nosniff" always;
		access_log off;
	}

	# HTML не кэшируем и заголовок ему не ставим: PHP не отдаёт
	# Last-Modified, поэтому эвристический кэш браузера к странице
	# и не применяется. Ставить no-cache значило бы страховаться от
	# того, чего не происходит.

	# ── PHP ────────────────────────────────────────────────────────
	location / {
		try_files $uri $uri/ /index.php?$query_string;
	}

	location ~ \.php$ {
		# try_files первой строкой — не оптимизация, а защита.
		# Без неё в php-fpm уезжает ЛЮБОЙ адрес, кончающийся на .php,
		# существует файл или нет. Запрос вида
		#
		#     /assets/img/logo.svg/x.php
		#
		# попадает сюда, SCRIPT_FILENAME показывает на несуществующий
		# путь, и при cgi.fix_pathinfo=1 интерпретатор отступает назад
		# по пути, пока не найдёт существующий файл, — то есть берётся
		# исполнять logo.svg. Сегодня это ловит дефолт php-fpm
		# (security.limit_extensions=.php), то есть чужая настройка на
		# чужом сервере. Как появится загрузка файлов, цена ошибки —
		# исполнение залитого файла.
		try_files $uri =404;
		fastcgi_split_path_info ^(.+\.php)(/.+)$;
		fastcgi_pass unix:/var/run/php-fpm/САЙТ.sock;   # подставить свой
		fastcgi_index index.php;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		# Стандартный fastcgi_params HTTPS не передаёт, а по нему PHP ставит
		# флаг secure на cookie сессии формы. Блок только для 443 — поэтому on.
		fastcgi_param HTTPS on;
		include fastcgi_params;
	}

	# Запрещать по существу нечего: всё служебное лежит вне public/,
	# то есть вне докрута, и это надёжнее любого правила. Единственное
	# правило deny — выше, по точке в начале имени, и оно здесь не
	# вместо докрута, а под него: на случай, когда докрут окажется
	# не тот.
	#
	# Что может понадобиться добавить — ACME-челлендж для сертификата,
	# если панель кладёт его в папку сайта, а не в новый докрут. Тогда
	# прячем его из-под регулярных location префиксом ^~ (иначе .php
	# в этой папке отдался бы исходником):
	#
	#   location ^~ /.well-known/acme-challenge/ {
	#       root /var/www/САЙТ/data/www/САЙТ.ru;   # без /public
	#   }
	#
	# Проверить это ДО переключения докрута: иначе сертификат не
	# продлится, и узнаешь об этом через три месяца.

	# Сжатие. gzip обычно включён глобально, но статику движка он по
	# умолчанию не покрывает: нужен тип для woff2 и svg.
	gzip on;
	gzip_types text/css application/javascript image/svg+xml application/json;
	gzip_min_length 1024;
}


# ─────────────────────────────────────────────────────────────────────
#  Стейджинг (dev.САЙТ.ru) — тот же блок, но БЕЗ раздела 4.
#
#  Кэш там вредит: после git pull хочется видеть новые файлы сразу, а
#  не объяснять браузеру, что год ещё не прошёл. Индексацию стейджинга
#  закрывает head.php сам — он ставит noindex на любом хосте, кроме
#  боевого, так что отдельных правил здесь не нужно.
# ─────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────
#  FastPanel — разобрано на переносе dev.ritmo.studio (ноябрь 2026)
#
#  Панель генерирует конфиг сама, из своих полей. Поэтому порядок
#  такой: сначала поля, и только то, что полями не задаётся, — руками
#  в «Ручная настройка» (это и есть редактор конфига домена).
#
#  ── Докрут ─────────────────────────────────────────────────────────
#  В новой форме сайта «Рабочая директория» недоступна для правки, а
#  public задаётся соседним полем «Рабочая поддиректория»: вписать
#  туда  public  — и всё. Конфиг соберётся с  root .../САЙТ//public
#  (двойной слэш безвреден, это склейка полей).
#
#  ── Главный капкан: try_files ──────────────────────────────────────
#  Для PHP-сайта панель настраивает маршрут как для одностраничного
#  приложения:
#
#      location / { try_files $uri $uri/ /index.php?$args; }
#
#  Нашему движку это противопоказано. Страница у нас — настоящая папка
#  с index.php, роутера нет, и «не нашёл файл → отдай /index.php»
#  означает: ЛЮБОЙ несуществующий адрес отдаёт ГЛАВНУЮ с кодом 200.
#  Для поиска это бесконечный набор дублей главной, и заметить это по
#  виду сайта нельзя — страница-то открывается. Менять на:
#
#      location / { try_files $uri $uri/ =404; }
#      error_page 404 /404.php;
#
#  Тот же fallback панель ставит и во втором location — длинном
#  регулярном, со списком расширений (jpg|png|css|js|...). Там он
#  тоже вредит: отсутствующая картинка отдаётся как HTML главной под
#  видом image/png. Менять на:
#
#      try_files $uri =404;
#
#  ── gzip ───────────────────────────────────────────────────────────
#  Список панели промахивается в обе стороны: нет image/svg+xml (а он
#  у нас крупный — один preloader.svg это 178 КБ, жмётся до ~41), зато
#  есть jpeg/png/gif, которые сжаты внутри формата и от gzip только
#  греют процессор. Рабочий список:
#
#      gzip_types text/css image/svg+xml application/javascript
#                 application/json application/pdf;
#      gzip_comp_level 5;      # панельная единица — зря
#
#  text/html не пишем: nginx жмёт его всегда, строка в списке — след
#  копипасты. woff2 не пишем: внутри уже Brotli.
#
#  ── Что проверять после КАЖДОГО сохранения сайта в панели ──────────
#  Ручные правки живут до первого сохранения настроек в интерфейсе:
#  панель перегенерирует конфиг, и try_files вернётся. Докрут при
#  этом уцелеет — он собран из поля.
#
#      curl -s -o /dev/null -w '%{http_code}\n' https://САЙТ/nope/
#
#  Ждём 404. Пришла 200 — конфиг перегенерирован, правки повторить.
#
#  ── git ────────────────────────────────────────────────────────────
#  На свежем сервере git может быть просто не установлен (apt install
#  git), а сайт при этом уже «работает»: файлы заливают копированием
#  вместе с папкой .git, и репозиторий цел — его некому прочитать.
#  После копирования по FTP теряется бит исполняемости, это видно как
#  изменённые файлы с пустым diff (old mode 100755 / new mode 100644);
#  лечится chmod +x, а не откатом.
#
#  Хуже другое, и это стоило нам деплоя (ноябрь 2026). FTP в текстовом
#  режиме портит сжатые файлы, а объекты git сжаты все. Так на
#  dev.ritmo.studio приехал битый .git: git pull упал на
#  «corrupt loose object», а git fsck показал не один такой объект,
#  а россыпь. Паки при этом были целы — повреждение было ровно в тех
#  объектах, что лежат россыпью, то есть в скопированных.
#
#  Починке это не подлежит и не нужно: на сервере код только читают,
#  репозиторий там расходный. Лечение — клонировать заново рядом,
#  перенести то, чего нет в гите, и подменить папку:
#
#      git clone <remote> site.new
#      rsync -a --ignore-existing --exclude=.git САЙТ/ site.new/
#      mv САЙТ site.broken && mv site.new САЙТ
#
#  rsync именно с --ignore-existing: он доносит только отсутствующее
#  и не трогает свежий чекаут. Медиа по .gitignore живёт только на
#  хостинге, и простой клон поверх его бы потерял. Старую папку
#  держать до проверки сайта — откат это один mv. Всё от имени
#  пользователя сайта, не от root.
#
#  Вывод на будущее: деплой только git pull. Копированием — никогда,
#  даже «один раз, чтобы быстрее».
#
#  Команды — от имени пользователя сайта, не от root: иначе pull
#  создаст файлы с владельцем root, и PHP-FPM их не прочитает.
#
#      su -s /bin/bash -c 'cd /путь/к/сайту && git pull --ff-only' ПОЛЬЗОВАТЕЛЬ
#
#  --ff-only: на сервере код только читают, расхождение истории — это
#  всегда след ручных правок, и узнать о нём надо сразу, а не получить
#  коммит слияния на боевой машине.
# ─────────────────────────────────────────────────────────────────────
